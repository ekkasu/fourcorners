{
 "rules": {
  ".read": false,
  ".write": false,
  "rooms": {
   "$code": {
    ".read": "auth != null && data.child('meta/players').child(auth.uid).exists() && data.child('meta/expires').val() > now",
    "inputs": {
     "$uid": {
      ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta/players').child(auth.uid).exists() && root.child('rooms').child($code).child('meta/expires').val() > now",
      ".validate": "newData.hasChildren(['x','z','sprint','shoot','release','at'])",
      "x": {".validate":"newData.isNumber() && newData.val() >= -2 && newData.val() <= 2"},
      "z": {".validate":"newData.isNumber() && newData.val() >= -2 && newData.val() <= 2"},
      "sprint": {".validate":"newData.isBoolean()"},
      "shoot": {".validate":"newData.isBoolean()"},
      "release": {".validate":"newData.isNumber() && newData.val() >= 0"},
      "at": {".validate":"newData.isNumber() && newData.val() <= now + 10000"},
      "$other": {".validate":false}
     }
    },
    "presence": {"$uid": {
     ".write":"auth != null && auth.uid === $uid && root.child('rooms').child($code).child('meta/players').child(auth.uid).exists()",
     ".validate":"newData.isBoolean()"
    }},
    "state": {
     ".write":"auth != null && root.child('rooms').child($code).child('meta/hostId').val() === auth.uid && root.child('rooms').child($code).child('meta/started').val() === true && root.child('rooms').child($code).child('meta/expires').val() > now",
     ".validate":"newData.hasChildren(['matchId','tick','players','ball','finished']) && newData.child('matchId').val() === root.child('rooms').child($code).child('meta/matchId').val() && newData.child('tick').isNumber() && newData.child('tick').val() >= 0 && newData.child('tick').val() <= 11000 && newData.child('players').hasChildren(['0','1']) && newData.child('finished').isBoolean()"
    }
   }
  }
 }
}
